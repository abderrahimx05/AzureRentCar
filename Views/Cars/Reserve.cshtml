@{
    var car = (AzureCarRental.Models.Car)ViewData["Car"]!;
}

<a href="/Cars/Index" class="btn btn-outline-secondary mb-4">
    <i class="fas fa-arrow-left"></i> Back to List
</a>

<div class="page-header">
    <h1><i class="fas fa-calendar-check"></i> Reserve @car.Brand @car.Model</h1>
    <p>Complete your reservation by filling in the details below</p>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="details-container">
            <h5 class="mb-3"><i class="fas fa-car"></i> Vehicle Summary</h5>

            @if (!string.IsNullOrEmpty(car.ImageUrl))
            {
                <img src="@car.ImageUrl" class="img-fluid rounded mb-3" alt="@car.Brand @car.Model"
                     style="max-height: 200px; object-fit: cover;">
            }
            else
            {
                <div class="bg-secondary rounded mb-3 d-flex align-items-center justify-content-center"
                     style="height: 200px;">
                    <i class="fas fa-car text-white" style="font-size: 3rem;"></i>
                </div>
            }

            <div class="detail-item">
                <span class="detail-label">Vehicle</span>
                <span class="detail-value">@car.Brand @car.Model</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Year</span>
                <span class="detail-value">@car.Year</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Daily Rate</span>
                <span class="detail-value price-tag">€@car.DailyRate.ToString("F2")</span>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="details-container">
            <h5 class="mb-4"><i class="fas fa-user"></i> Reservation Details</h5>

            <form method="post">
                <div class="mb-3">
                    <label for="customerName" class="form-label">
                        <i class="fas fa-user"></i> Full Name
                    </label>
                    <input type="text" class="form-control" id="customerName" name="customerName" placeholder="John Doe"
                           required>
                </div>

                <div class="mb-3">
                    <label for="customerEmail" class="form-label">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input type="email" class="form-control" id="customerEmail" name="customerEmail"
                           placeholder="john@example.com" required>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="startDate" class="form-label">
                            <i class="fas fa-calendar"></i> Start Date
                        </label>
                        <input type="date" class="form-control" id="startDate" name="startDate" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="endDate" class="form-label">
                            <i class="fas fa-calendar"></i> End Date
                        </label>
                        <input type="date" class="form-control" id="endDate" name="endDate" required>
                    </div>
                </div>

                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle"></i>
                    <strong>Price Calculation:</strong> The total price will be calculated based on the number of days ×
                    €@car.DailyRate.ToString("F2")/day
                </div>

                <input type="hidden" name="carId" value="@car.Id">

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-check-circle"></i> Confirm Reservation
                    </button>
                    <a href="/Cars/Index" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-times-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>