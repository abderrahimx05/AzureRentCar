@model AzureCarRental.Models.Car

<a href="/Cars/Index" class="btn btn-outline-secondary mb-4">
    <i class="fas fa-arrow-left"></i> Back to List
</a>

<div class="page-header">
    <h1>@Model.Brand <strong>@Model.Model</strong></h1>
    <p>View vehicle details and make a reservation</p>
</div>

<div class="row">
    <div class="col-lg-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="details-image shadow" alt="@Model.Brand @Model.Model">
        }
        else
        {
            <div class="details-image bg-secondary d-flex align-items-center justify-content-center shadow">
                <i class="fas fa-car text-white" style="font-size: 5rem;"></i>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <div class="details-container">
            <div class="detail-item">
                <span class="detail-label"><i class="fas fa-building"></i> Brand</span>
                <span class="detail-value">@Model.Brand</span>
            </div>

            <div class="detail-item">
                <span class="detail-label"><i class="fas fa-car"></i> Model</span>
                <span class="detail-value">@Model.Model</span>
            </div>

            <div class="detail-item">
                <span class="detail-label"><i class="fas fa-calendar"></i> Year</span>
                <span class="detail-value">@Model.Year</span>
            </div>

            <div class="detail-item">
                <span class="detail-label"><i class="fas fa-euro-sign"></i> Daily Rate</span>
                <span class="detail-value price-tag">€@Model.DailyRate.ToString("F2")</span>
            </div>

            <div class="detail-item">
                <span class="detail-label"><i class="fas fa-check-circle"></i> Status</span>
                <span class="detail-value">
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-check"></i> Available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            <i class="fas fa-times"></i> Not Available
                        </span>
                    }
                </span>
            </div>

            <div class="mt-4 d-grid gap-2">
                @if (Model.IsAvailable)
                {
                    <a href="/Cars/Reserve/@Model.Id" class="btn btn-success btn-lg">
                        <i class="fas fa-calendar-check"></i> Reserve This Vehicle
                    </a>
                }
                else
                {
                    <button class="btn btn-danger btn-lg" disabled>
                        <i class="fas fa-ban"></i> Not Available for Reservation
                    </button>
                }
                <a href="/Cars/Index" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>