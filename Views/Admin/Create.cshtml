@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle"></i> Add New Vehicle</h1>
    <p>Add a new vehicle to your rental fleet</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="details-container">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="brand" class="form-label">
                        <i class="fas fa-building"></i> Brand
                    </label>
                    <input type="text" class="form-control" id="brand" name="brand" placeholder="e.g., BMW, Mercedes"
                           required>
                </div>

                <div class="mb-3">
                    <label for="model" class="form-label">
                        <i class="fas fa-car"></i> Model
                    </label>
                    <input type="text" class="form-control" id="model" name="model"
                           placeholder="e.g., 3 Series, C-Class" required>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="year" class="form-label">
                            <i class="fas fa-calendar"></i> Year
                        </label>
                        <input type="number" class="form-control" id="year" name="year" placeholder="2023" min="2000"
                               required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="dailyRate" class="form-label">
                            <i class="fas fa-euro-sign"></i> Daily Rate
                        </label>
                        <input type="number" step="0.01" class="form-control" id="dailyRate" name="dailyRate"
                               placeholder="99.99" min="0" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="isAvailable" class="form-label">
                        <i class="fas fa-check"></i> Availability
                    </label>
                    <select class="form-select" id="isAvailable" name="isAvailable" required>
                        <option value="true">Available</option>
                        <option value="false">Not Available</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">
                        <i class="fas fa-image"></i> Vehicle Image
                    </label>
                    <input type="file" class="form-control" id="image" name="image" accept="image/*">
                    <small class="text-muted d-block mt-2">Upload a vehicle image (optional)</small>

                    <!-- Image Preview -->
                    <div id="imagePreview" style="display: none; margin-top: 15px;">
                        <img id="previewImg" src="" alt="Preview"
                             style="max-width: 200px; max-height: 200px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    </div>

                    <!-- Upload Status -->
                    <div id="uploadStatus" style="display: none; margin-top: 10px;">
                        <small class="text-success"><i class="fas fa-check-circle"></i> Image ready for upload</small>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-check-circle"></i> Add Vehicle
                    </button>
                    <a href="/Admin/Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Image preview functionality
    document.getElementById('image').addEventListener('change', function (e) {
        const file = e.target.files[0];
        const preview = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        const uploadStatus = document.getElementById('uploadStatus');

        if (file) {
            const reader = new FileReader();
            reader.onload = function (event) {
                previewImg.src = event.target.result;
                preview.style.display = 'block';
                uploadStatus.style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            preview.style.display = 'none';
            uploadStatus.style.display = 'none';
        }
    });

    // Form submit feedback
    document.querySelector('form').addEventListener('submit', function () {
        const submitBtn = document.querySelector('button[type="submit"]');
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
        submitBtn.disabled = true;
    });
</script>