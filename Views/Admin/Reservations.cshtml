@model List<Reservation>
@{
    ViewData["Title"] = "All Reservations";
}

<div class="page-header" style="animation: slideInDown 0.6s ease-out;">
    <h1><i class="fas fa-file-invoice"></i> All Reservations</h1>
    <p>Manage and track all customer reservations</p>
</div>

<div style="animation: fadeInUp 0.8s ease-out;">
    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> No reservations yet.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-dark">
                <h5 class="mb-0">
                    <i class="fas fa-calendar-check"></i> Total Reservations: <span
                    class="badge bg-light text-dark">@Model.Count</span>
                </h5>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-id-badge"></i> ID</th>
                            <th><i class="fas fa-car"></i> Car ID</th>
                            <th><i class="fas fa-user"></i> Customer</th>
                            <th><i class="fas fa-envelope"></i> Email</th>
                            <th><i class="fas fa-calendar-alt"></i> Start Date</th>
                            <th><i class="fas fa-calendar-alt"></i> End Date</th>
                            <th><i class="fas fa-clock"></i> Days</th>
                            <th><i class="fas fa-money-bill"></i> Total Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model)
                        {
                            var days = (res.EndDate - res.StartDate).Days;
                            <tr style="animation: slideInLeft 0.5s ease-out;">
                                <td>
                                    <span class="badge bg-primary">#@res.Id</span>
                                </td>
                                <td>
                                    <span class="badge bg-info">@res.CarId</span>
                                </td>
                                <td>
                                    <strong>@res.CustomerName</strong>
                                </td>
                                <td>
                                    <small>@res.CustomerEmail</small>
                                </td>
                                <td>
                                    @res.StartDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @res.EndDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">@days day(s)</span>
                                </td>
                                <td>
                                    <span class="badge bg-success">$@res.TotalPrice.ToString("F2")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4" style="animation: fadeInUp 1s ease-out 0.2s both;">
            <div class="row">
                <div class="col-md-3">
                    <div class="card bg-light text-center">
                        <div class="card-body">
                            <i class="fas fa-file-invoice-dollar"
                               style="font-size: 2rem; color: #198754; margin-bottom: 1rem;"></i>
                            <h6>Total Revenue</h6>
                            <p class="h4 text-success mb-0">$@Model.Sum(r => r.TotalPrice).ToString("F2")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light text-center">
                        <div class="card-body">
                            <i class="fas fa-users" style="font-size: 2rem; color: #0d6efd; margin-bottom: 1rem;"></i>
                            <h6>Unique Customers</h6>
                            <p class="h4 text-primary mb-0">@Model.Select(r => r.CustomerEmail).Distinct().Count()</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light text-center">
                        <div class="card-body">
                            <i class="fas fa-calendar-alt"
                               style="font-size: 2rem; color: #ffc107; margin-bottom: 1rem;"></i>
                            <h6>Total Days</h6>
                            <p class="h4 text-warning mb-0">@Model.Sum(r => (r.EndDate - r.StartDate).Days)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light text-center">
                        <div class="card-body">
                            <i class="fas fa-file-invoice"
                               style="font-size: 2rem; color: #dc3545; margin-bottom: 1rem;"></i>
                            <h6>Avg. Reservation</h6>
                            <p class="h4 text-danger mb-0">$@(Model.Count > 0 ? (Model.Sum(r => r.TotalPrice) /
                                                            Model.Count).ToString("F2") : "0.00")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a href="/Admin/Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Fleet
        </a>
    </div>