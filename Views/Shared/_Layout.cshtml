<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentCar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium-ui.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
    <header style="animation: slideInDown 0.6s ease-out;">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top" style="background: linear-gradient(90deg, #0d6efd 0%, #0a58ca 100%);">
            <div class="container-lg">
                <a class="navbar-brand fw-bold fs-5" href="/" style="letter-spacing: 1px; transition: all 0.3s ease; animation: slideInLeft 0.6s ease-out;">
                    <i class="fas fa-car" style="animation: bounce 2s infinite;"></i> RENTCAR
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Cars/Index" style="transition: all 0.3s ease;">
                                <i class="fas fa-car"></i> Véhicules
                            </a>
                        </li>
                        
                        @{
                            var userId = Context.Session.GetInt32("UserId");
                            var userName = Context.Session.GetString("UserName");
                            var userRole = Context.Session.GetString("UserRole");
                        }

                        @if (userId.HasValue)
                        {
                            @if (userRole == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" href="/Admin/Index">
                                        <i class="fas fa-sliders-h"></i> Gestion de la flotte
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" href="/Admin/Reservations">
                                        <i class="fas fa-file-invoice"></i> Réservations
                                    </a>
                                </li>
                            }
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> @userName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <h6 class="dropdown-header">
                                            <strong>@userName</strong><br>
                                            <small class="text-muted">@Context.Session.GetString("UserEmail")</small>
                                        </h6>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="/Auth/Dashboard">
                                            <i class="fas fa-tachometer-alt"></i> Tableau de bord
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="/Auth/Logout">
                                            <i class="fas fa-sign-out-alt"></i> Déconnexion
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Auth/Login">
                                    <i class="fas fa-sign-in-alt"></i> Connexion
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Auth/Register">
                                    <i class="fas fa-user-plus"></i> Inscription
                                </a>
                            </li>
                        }

                        <!-- Language Selector -->
                        <li class="nav-item dropdown">
                            <button class="btn btn-outline-light btn-sm ms-2" id="language-selector-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="transition: all 0.3s ease;">
                                🌍 FR
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" id="language-dropdown">
                                <li><a class="dropdown-item" href="#" onclick="window.appLanguage.setLanguage('FR'); return false;">🇫🇷 Français</a></li>
                                <li><a class="dropdown-item" href="#" onclick="window.appLanguage.setLanguage('EN'); return false;">🇬🇧 English</a></li>
                                <li><a class="dropdown-item" href="#" onclick="window.appLanguage.setLanguage('ES'); return false;">🇪🇸 Español</a></li>
                                <li><a class="dropdown-item" href="#" onclick="window.appLanguage.setLanguage('DE'); return false;">🇩🇪 Deutsch</a></li>
                                <li><a class="dropdown-item" href="#" onclick="window.appLanguage.setLanguage('IT'); return false;">🇮🇹 Italiano</a></li>
                                <li><a class="dropdown-item" href="#" onclick="window.appLanguage.setLanguage('PT'); return false;">🇵🇹 Português</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 py-5 bg-light">
        <div class="container-lg">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container-lg">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h6><i class="fas fa-car"></i> Azure Car Rental</h6>
                    <p class="small text-muted">Premium car rental service powered by Azure.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/Cars/Index" class="text-muted text-decoration-none">Browse Cars</a></li>
                        <li><a href="/Cars/Create" class="text-muted text-decoration-none">Add Vehicle</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Contact</h6>
                    <p class="small text-muted">
                        <i class="fas fa-envelope"></i> admin@azurecarrental.com<br>
                        <i class="fas fa-phone"></i> +1 (555) 123-4567
                    </p>
                </div>
            </div>
            <hr class="bg-secondary">
            <p class="text-center small text-muted mb-0">&copy; 2026 Azure Car Rental. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sas-loader.js" asp-append-version="true"></script>
    <script src="~/js/language.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>