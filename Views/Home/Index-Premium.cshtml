@{
    ViewData["Title"] = "Azure Car Rental - Premium Car Rental Service";
}

<style>
    body {
        background: linear-gradient(135deg, #0f0f0f 0%, #1a1a2e 100%);
    }
</style>

<!-- ===== HERO SECTION ===== -->
<section class="hero-section">
    <div class="hero-background"></div>

    <div class="hero-canvas" id="heroCanvas">🚗</div>

    <div class="container-lg hero-content">
        <h1 class="hero-title">Location de Voitures Premium</h1>
        <p class="hero-subtitle">Louez facilement. Roulez avec style.</p>

        <div class="hero-buttons">
            <a href="/Cars/Index" class="btn-premium btn-primary-gradient">
                <i class="fas fa-arrow-right"></i> Parcourir les véhicules
            </a>
            <a href="#features" class="btn-premium btn-outline-light-premium">
                <i class="fas fa-info-circle"></i> En savoir plus
            </a>
        </div>
    </div>
</section>

<!-- ===== FEATURES SECTION ===== -->
<section id="features" class="features-section">
    <div class="container-lg">
        <div style="text-align: center; margin-bottom: 60px; animation: fadeInUp 0.8s ease-out;">
            <h2
                style="font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 800; margin-bottom: 15px; background: linear-gradient(135deg, #ffffff 0%, #00d9ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                Pourquoi nous choisir ?
            </h2>
            <p style="font-size: 1.1rem; color: #b0b0b0; max-width: 600px; margin: 0 auto;">
                L'expérience de location la plus fluide et moderne du marché
            </p>
        </div>

        <div class="features-grid">
            <!-- Feature 1 -->
            <div class="feature-card" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
                <div class="feature-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h3 class="feature-title">Réservation Rapide</h3>
                <p class="feature-description">
                    Réservez en quelques clics. Aucune paperasserie, juste la simplicité.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="feature-card" style="animation: fadeInUp 0.8s ease-out 0.2s both;">
                <div class="feature-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3 class="feature-title">Sécurité Garantie</h3>
                <p class="feature-description">
                    Tous nos véhicules sont assurés et régulièrement entretenus.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="feature-card" style="animation: fadeInUp 0.8s ease-out 0.3s both;">
                <div class="feature-icon">
                    <i class="fas fa-star"></i>
                </div>
                <h3 class="feature-title">Véhicules Premium</h3>
                <p class="feature-description">
                    Sélection exclusive de voitures haut de gamme et modernes.
                </p>
            </div>

            <!-- Feature 4 -->
            <div class="feature-card" style="animation: fadeInUp 0.8s ease-out 0.4s both;">
                <div class="feature-icon">
                    <i class="fas fa-headset"></i>
                </div>
                <h3 class="feature-title">Support 24/7</h3>
                <p class="feature-description">
                    Notre équipe est toujours disponible pour vous aider.
                </p>
            </div>

            <!-- Feature 5 -->
            <div class="feature-card" style="animation: fadeInUp 0.8s ease-out 0.5s both;">
                <div class="feature-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <h3 class="feature-title">Tarifs Transparents</h3>
                <p class="feature-description">
                    Pas de frais cachés. Vous payez exactement ce que vous voyez.
                </p>
            </div>

            <!-- Feature 6 -->
            <div class="feature-card" style="animation: fadeInUp 0.8s ease-out 0.6s both;">
                <div class="feature-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <h3 class="feature-title">Partout en Ville</h3>
                <p class="feature-description">
                    Multiples points de retrait pour votre commodité.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ===== CTA SECTION ===== -->
<section
    style="padding: 100px 20px; text-align: center; background: linear-gradient(135deg, rgba(0, 102, 255, 0.1) 0%, rgba(0, 217, 255, 0.1) 100%); border-top: 1px solid rgba(255, 255, 255, 0.1); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
    <div class="container-lg" style="animation: fadeInUp 1s ease-out;">
        <h2
            style="font-size: clamp(2rem, 5vw, 2.5rem); font-weight: 800; margin-bottom: 20px; background: linear-gradient(135deg, #ffffff 0%, #00d9ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            Prêt à rouler ?
        </h2>
        <p
            style="font-size: 1.1rem; color: #b0b0b0; margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto;">
            Découvrez notre collection exclusive de véhicules premium
        </p>
        <a href="/Cars/Index" class="btn-premium btn-primary-gradient">
            <i class="fas fa-car"></i> Voir la collection
        </a>
    </div>
</section>

<script>
    // Parallax effect
    document.addEventListener('DOMContentLoaded', function () {
        const heroSection = document.querySelector('.hero-section');

        window.addEventListener('scroll', function () {
            const scrollY = window.scrollY;
            heroSection.style.backgroundPosition = `0 ${scrollY * 0.5}px`;
        });
    });
</script>